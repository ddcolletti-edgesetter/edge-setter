# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ─── Stripe (LIVE keys for production) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (transactional email) ────────────────────────────────────────────
# Get key at https://resend.com — leave empty to disable email sending
RESEND_API_KEY=

# ─── App config ──────────────────────────────────────────────────────────────
# Set to your production URL (no trailing slash)
BASE_URL=https://edgesetter.com
FROM_EMAIL=Edge Setter <hello@edgesetter.com>
ADMIN_PASSWORD=edgesetter-admin-2026

# ─── SQLite persistent disk ───────────────────────────────────────────────────
# On Render: set to /var/data (matches render.yaml disk mountPath)
# Locally: leave unset (defaults to project root)
DATA_DIR=/var/data
