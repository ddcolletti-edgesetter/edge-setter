# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ─── Stripe (LIVE keys for production) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (transactional email) ────────────────────────────────────────────
# Get key at https://resend.com — leave empty to disable email sending
RESEND_API_KEY=

# ─── App config ──────────────────────────────────────────────────────────────
# Set to your production URL (no trailing slash)
BASE_URL=https://edgesetter.com
FROM_EMAIL=Edge Setter <hello@edgesetter.com>
ADMIN_PASSWORD=edgesetter-admin-2026

# ─── BallDontLie NBA API ─────────────────────────────────────────────────────
# Required for NBA injury/game data (v1 API requires a key even on free tier)
# Get a free key at https://www.balldontlie.io
BALLDONTLIE_API_KEY=

# ─── Twitter / X API (auto-posting) ──────────────────────────────────────────
# All four required for auto-posting. Leave empty to disable auto-posting.
# Get credentials at https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Discord (auto-posting) ───────────────────────────────────────────────────
# Webhook URL from Discord server settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# ─── Telegram (auto-posting) ─────────────────────────────────────────────────
# Bot token from @BotFather. Chat ID = channel/group to post to (e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── SQLite persistent disk ───────────────────────────────────────────────────
# On Render: set to /var/data (matches render.yaml disk mountPath)
# Locally: leave unset (defaults to project root)
DATA_DIR=/var/data
